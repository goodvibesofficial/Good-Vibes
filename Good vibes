-- ============================================================================
-- UI MOTION ENGINE (Optimized v4.1)
-- ============================================================================
local UIMotion = {}

function UIMotion.Float(guiElement, amplitude, speed)
    amplitude = amplitude or 5
    speed = speed or 2.5
    task.spawn(function()
        local originalPos = guiElement.Position
        while guiElement and guiElement.Parent do
            local t1 = TweenService:Create(guiElement, TweenInfo.new(speed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Position = originalPos + UDim2.new(0, 0, 0, -amplitude)
            })
            t1:Play() t1.Completed:Wait()
            local t2 = TweenService:Create(guiElement, TweenInfo.new(speed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Position = originalPos + UDim2.new(0, 0, 0, amplitude)
            })
            t2:Play() t2.Completed:Wait()
        end
    end)
end

function UIMotion.HologramGlitch(guiElement)
    task.spawn(function()
        while guiElement and guiElement.Parent do
            task.wait(math.random(6, 12))
            local origTrans = guiElement.BackgroundTransparency
            for _ = 1, 2 do
                guiElement.BackgroundTransparency = math.clamp(origTrans + 0.3, 0, 1)
                guiElement.Position = guiElement.Position + UDim2.new(0, math.random(-2, 2), 0, math.random(-1, 1))
                task.wait(0.03)
                guiElement.BackgroundTransparency = origTrans
                guiElement.Position = guiElement.Position - UDim2.new(0, math.random(-2, 2), 0, math.random(-1, 1))
                task.wait(0.05)
            end
        end
    end)
end

function UIMotion.ChromaBorder(uiStroke)
    task.spawn(function()
        local colors = {
            THEME.NeonPrimary,
            THEME.NeonSecondary,
            THEME.NeonAccent,
            THEME.Success,
            Color3.fromRGB(244, 114, 182)
        }
        local i = 1
        while uiStroke and uiStroke.Parent do
            local nextCol = colors[i]
            i = i % #colors + 1
            local tw = TweenService:Create(uiStroke, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Color = nextCol
            })
            tw:Play()
            tw.Completed:Wait()
        end
    end)
end

function UIMotion.ApplyElasticPress(button, originalScale)
    originalScale = originalScale or UDim2.new(1, 0, 1, 0)
    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = originalScale - UDim2.new(0, 4, 0, 4)
        }):Play()
    end)
    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
            Size = originalScale
        }):Play()
    end)
end

function UIMotion.IntroScaleIn(frame, duration)
    duration = duration or 0.5
    local targetSize = frame.Size
    frame.Size = UDim2.new(0, 0, 0, 0)
    local tw = TweenService:Create(frame, TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = targetSize
    })
    tw:Play()
end

