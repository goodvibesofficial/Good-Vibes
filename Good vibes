local function showNotification(title, message, duration)
    task.spawn(function()
        local card = Instance.new("Frame")
        card.Size = UDim2.new(0, 330, 0, 80)
        card.Position = UDim2.new(1, 60, 0, 0)
        card.BackgroundColor3 = THEME.Container
        card.BackgroundTransparency = 0.05
        card.ZIndex = 101
        card.Parent = notifHolder

        corner(card, 14)
        stroke(card, THEME.NeonPrimary, 1.5)

        -- Side indicator line with Glow Motion
        local indicator = Instance.new("Frame")
        indicator.Size = UDim2.new(0, 4, 1, -16)
        indicator.Position = UDim2.new(0, 8, 0, 8)
        indicator.BackgroundColor3 = THEME.NeonAccent
        indicator.BorderSizePixel = 0
        indicator.ZIndex = 102
        indicator.Parent = card
        corner(indicator, 2)
        
        task.spawn(function()
            while indicator and indicator.Parent do
                local t1 = TweenService:Create(indicator, TweenInfo.new(1.5, Enum.EasingStyle.Sine), {BackgroundColor3 = THEME.NeonPrimary})
                t1:Play() t1.Completed:Wait()
                local t2 = TweenService:Create(indicator, TweenInfo.new(1.5, Enum.EasingStyle.Sine), {BackgroundColor3 = THEME.NeonAccent})
                t2:Play() t2.Completed:Wait()
            end
        end)

        local tLabel = Instance.new("TextLabel")
        tLabel.Size = UDim2.new(1, -30, 0, 24)
        tLabel.Position = UDim2.new(0, 22, 0, 8)
        tLabel.BackgroundTransparency = 1
        tLabel.RichText = true
        tLabel.Text = title
        tLabel.Font = Enum.Font.Code
        tLabel.TextSize = 13
        tLabel.TextXAlignment = Enum.TextXAlignment.Left
        tLabel.ZIndex = 102
        tLabel.Parent = card

        local mLabel = Instance.new("TextLabel")
        mLabel.Size = UDim2.new(1, -30, 0, 40)
        mLabel.Position = UDim2.new(0, 22, 0, 32)
        mLabel.BackgroundTransparency = 1
        mLabel.RichText = true
        mLabel.Text = message
        mLabel.Font = Enum.Font.Code
        mLabel.TextSize = 11
        mLabel.TextXAlignment = Enum.TextXAlignment.Left
        mLabel.TextWrapped = true
        mLabel.ZIndex = 102
        mLabel.Parent = card

        local tweenIn = TweenService:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, 0)
        })
        tweenIn:Play()
        tweenIn.Completed:Wait()

        task.wait(duration or 4)

        local tweenOut = TweenService:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 60, 0, 0)
        })
        tweenOut:Play()
        tweenOut.Completed:Wait()
        card:Destroy()
    end)
end

