local function showNotification(title, message, duration)
    task.spawn(function()
        local wrapper = Instance.new("Frame")
        wrapper.Size = UDim2.new(0, 400, 0, 95)
        wrapper.BackgroundTransparency = 1
        wrapper.Parent = notifHolder
        
        local card = Instance.new("Frame")
        card.Size = UDim2.new(0, 0, 0, 0) -- Starts invisible for Supernova pop
        card.AnchorPoint = Vector2.new(0.5, 0.5)
        card.Position = UDim2.new(0.5, 0, 0.5, 0)
        card.BackgroundColor3 = THEME.Container
        card.BackgroundTransparency = 0.05
        card.ZIndex = 1001
        card.Parent = wrapper

        corner(card, 16)
        stroke(card, THEME.NeonAccent, 2.5)

        -- SUPERNOVA FLASH EFFECT
        local novaFlash = Instance.new("ImageLabel")
        novaFlash.AnchorPoint = Vector2.new(0.5, 0.5)
        novaFlash.Position = UDim2.new(0.5, 0, 0.5, 0)
        novaFlash.Size = UDim2.new(0, 0, 0, 0)
        novaFlash.BackgroundTransparency = 1
        novaFlash.Image = "rbxassetid://6014261993"
        novaFlash.ImageColor3 = Color3.fromRGB(255, 255, 255)
        novaFlash.ZIndex = 1000
        novaFlash.Parent = wrapper
        
        local flashTween = TweenService:Create(novaFlash, TweenInfo.new(0.6, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
            Size = UDim2.new(3, 0, 3, 0),
            ImageTransparency = 1,
            ImageColor3 = THEME.NeonPrimary
        })

        local indicator = Instance.new("Frame")
        indicator.Size = UDim2.new(0, 6, 1, -20)
        indicator.Position = UDim2.new(0, 10, 0, 10)
        indicator.BackgroundColor3 = THEME.NeonAccent
        indicator.BorderSizePixel = 0
        indicator.ZIndex = 1002
        indicator.Parent = card
        corner(indicator, 3)
        
        task.spawn(function()
            while indicator and indicator.Parent do
                local t1 = TweenService:Create(indicator, TweenInfo.new(1.5, Enum.EasingStyle.Sine), {BackgroundColor3 = THEME.NeonPrimary})
                t1:Play() t1.Completed:Wait()
                local t2 = TweenService:Create(indicator, TweenInfo.new(1.5, Enum.EasingStyle.Sine), {BackgroundColor3 = THEME.NeonAccent})
                t2:Play() t2.Completed:Wait()
            end
        end)

        local tLabel = Instance.new("TextLabel")
        tLabel.Size = UDim2.new(1, -30, 0, 30)
        tLabel.Position = UDim2.new(0, 0, 0, 10)
        tLabel.BackgroundTransparency = 1
        tLabel.RichText = true
        tLabel.Text = title
        tLabel.Font = Enum.Font.Code
        tLabel.TextSize = 16
        tLabel.TextXAlignment = Enum.TextXAlignment.Center -- Centered to be unignorable
        tLabel.ZIndex = 1002
        tLabel.Parent = card

        local mLabel = Instance.new("TextLabel")
        mLabel.Size = UDim2.new(1, -40, 0, 45)
        mLabel.Position = UDim2.new(0, 20, 0, 40)
        mLabel.BackgroundTransparency = 1
        mLabel.RichText = true
        mLabel.Text = message
        mLabel.Font = Enum.Font.Code
        mLabel.TextSize = 13
        mLabel.TextXAlignment = Enum.TextXAlignment.Center
        mLabel.TextWrapped = true
        mLabel.ZIndex = 1002
        mLabel.Parent = card

        -- Execute Supernova & Pop in
        flashTween:Play()
        local tweenIn = TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 1, 0)
        })
        tweenIn:Play()
        
        task.delay(0.6, function()
            if novaFlash then novaFlash:Destroy() end
        end)

        task.wait(duration or 4)

        -- Shrink out
        local tweenOut = TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0)
        })
        tweenOut:Play()
        tweenOut.Completed:Wait()
        wrapper:Destroy()
    end)
end

