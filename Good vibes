-- 1. Continuous Floating Levitation Loop
function UIMotion.Float(guiElement, amplitude, speed)
    amplitude = amplitude or 6
    speed = speed or 2.5
    task.spawn(function()
        local originalPos = guiElement.Position
        while guiElement and guiElement.Parent do
            local t1 = TweenService:Create(guiElement, TweenInfo.new(speed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Position = originalPos + UDim2.new(0, 0, 0, -amplitude)
            })
            t1:Play() t1.Completed:Wait()
            local t2 = TweenService:Create(guiElement, TweenInfo.new(speed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Position = originalPos + UDim2.new(0, 0, 0, amplitude)
            })
            t2:Play() t2.Completed:Wait()
        end
    end)
end

-- 2. Cyberpunk Holographic Glitch Jump Sequence
function UIMotion.HologramGlitch(guiElement)
    task.spawn(function()
        while guiElement and guiElement.Parent do
            task.wait(math.random(4, 9))
            local origTrans = guiElement.BackgroundTransparency
            for _ = 1, 3 do
                guiElement.BackgroundTransparency = math.clamp(origTrans + 0.4, 0, 1)
                guiElement.Position = guiElement.Position + UDim2.new(0, math.random(-4, 4), 0, math.random(-2, 2))
                task.wait(0.04)
                guiElement.BackgroundTransparency = origTrans
                guiElement.Position = guiElement.Position - UDim2.new(0, math.random(-4, 4), 0, math.random(-2, 2))
                task.wait(0.06)
            end
        end
    end)
end

-- 3. Neon Border Chroma Cycle
function UIMotion.ChromaBorder(uiStroke)
    task.spawn(function()
        local colors = {
            THEME.NeonPrimary,
            THEME.NeonSecondary,
            THEME.NeonAccent,
            THEME.Success,
            Color3.fromRGB(244, 114, 182),
            Color3.fromRGB(251, 191, 36),
            Color3.fromRGB(129, 140, 248),
            Color3.fromRGB(45, 212, 191),
            Color3.fromRGB(236, 72, 153)
        }
        local i = 1
        while uiStroke and uiStroke.Parent do
            local nextCol = colors[i]
            i = i % #colors + 1
            local tw = TweenService:Create(uiStroke, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Color = nextCol
            })
            tw:Play()
            tw.Completed:Wait()
        end
    end)
end

-- 4. Pulsing Glow Swell
function UIMotion.GlowPulse(glowImage)
    task.spawn(function()
        while glowImage and glowImage.Parent do
            local t1 = TweenService:Create(glowImage, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                ImageTransparency = 0.25,
                Size = UDim2.new(1, 60, 1, 60)
            })
            t1:Play() t1.Completed:Wait()
            local t2 = TweenService:Create(glowImage, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                ImageTransparency = 0.75,
                Size = UDim2.new(1, 30, 1, 30)
            })
            t2:Play() t2.Completed:Wait()
        end
    end)
end

-- 5. Button Press Elastic Spring Animation
function UIMotion.ApplyElasticPress(button, originalScale)
    originalScale = originalScale or UDim2.new(1, 0, 1, 0)
    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = originalScale - UDim2.new(0, 6, 0, 6)
        }):Play()
    end)
    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
            Size = originalScale
        }):Play()
    end)
end

-- 6. HUD Entrance Swivel/Scale Intro
function UIMotion.IntroScaleIn(frame, duration)
    duration = duration or 0.6
    local targetSize = frame.Size
    frame.Size = UDim2.new(0, 0, 0, 0)
    local tw = TweenService:Create(frame, TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = targetSize
    })
    tw:Play()
end

