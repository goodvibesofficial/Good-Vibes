-- Utility Functions for Modern UI
local function corner(parent, value)
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, value)
    UICorner.Parent = parent
end

local function stroke(parent, color, thickness)
    local UIStroke = Instance.new("UIStroke")
    UIStroke.Name = "DynamicStroke"
    UIStroke.Color = color
    UIStroke.Thickness = thickness
    UIStroke.Transparency = 0.2
    UIStroke.Parent = parent
end

local function createGlow(parent)
    local glow = Instance.new("ImageLabel")
    glow.Name = "GlowEffect"
    glow.AnchorPoint = Vector2.new(0.5, 0.5)
    glow.Position = UDim2.new(0.5, 0, 0.5, 0)
    glow.Size = UDim2.new(1, 40, 1, 40)
    glow.BackgroundTransparency = 1
    glow.Image = "rbxassetid://6014261993"
    glow.ImageColor3 = THEME.NeonPrimary
    glow.ImageTransparency = 0.6
    glow.ZIndex = parent.ZIndex - 1
    glow.Parent = parent
    
    -- Continuous Glow Motion / Pulsing Animation Loop
    task.spawn(function()
        while glow and glow.Parent do
            local tween1 = TweenService:Create(glow, TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                ImageTransparency = 0.3,
                Size = UDim2.new(1, 55, 1, 55)
            })
            tween1:Play()
            tween1.Completed:Wait()
            
            local tween2 = TweenService:Create(glow, TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                ImageTransparency = 0.7,
                Size = UDim2.new(1, 35, 1, 35)
            })
            tween2:Play()
            tween2.Completed:Wait()
        end
    end)
    
    -- Dynamic Neon Color Shifting for Borders / Strokes
    task.spawn(function()
        local uiStroke = parent:FindFirstChild("DynamicStroke", true)
        while uiStroke and uiStroke.Parent do
            local colorTween1 = TweenService:Create(uiStroke, TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Color = THEME.NeonSecondary
            })
            colorTween1:Play()
            colorTween1.Completed:Wait()
            
            local colorTween2 = TweenService:Create(uiStroke, TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Color = THEME.NeonPrimary
            })
            colorTween2:Play()
            colorTween2.Completed:Wait()
        end
    end)
end

