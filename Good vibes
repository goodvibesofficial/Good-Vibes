-- Player List Management
local function refreshPlayerList()
    for _, child in pairs(scrollframe1:GetChildren()) do
        if child.Name == "playername" then child:Destroy() end
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0.94, 0, 0, 32)
            btn.Name = "playername"
            btn.BackgroundColor3 = THEME.Element
            btn.Text = "  > " .. p.Name
            btn.TextColor3 = THEME.Text
            btn.Font = Enum.Font.Code
            btn.TextSize = 11
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Parent = scrollframe1
            corner(btn, 6)
            stroke(btn, Color3.fromRGB(50, 35, 70), 0.8)
            
            btn.MouseButton1Click:Connect(function()
                namebox.Text = p.Name
                showNotification("<font color='#38BDF8'>// OBJETIVO</font>", "<font color='#F5F3FF'>Fijado a: " .. p.Name .. "</font>", 2)
            end)
        end
    end
end
Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)
refreshPlayerList()

-- Safe Animator Helper
local function loadAndPlayAnim(humanoid, assetId)
    local success, track = pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. assetId
        local loaded = humanoid:LoadAnimation(anim)
        loaded.Looped = true
        loaded:Play()
        return loaded
    end)
    return success and track or nil
end

-- Animation Trigger Wrapper
local function se(nam, Ida, Idb, cof1, cof2, speed, tog)
    local isTeleporting = false
    local targetPlayer = nil
    local currentOffset = cof1
    local lastToggle = tick()

    local function getTarget()
        local query = namebox.Text:lower()
        if query == "" then return nil end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name:lower():sub(1, #query) == query or p.DisplayName:lower():sub(1, #query) == query then
                return p
            end
        end
        return nil
    end

    local animationButton = Instance.new("TextButton")
    animationButton.Size = UDim2.new(0.96, 0, 0, 36)
    animationButton.BackgroundColor3 = THEME.Element
    animationButton.Text = "  ⚡ " .. nam
    animationButton.TextColor3 = THEME.Subtext
    animationButton.Font = Enum.Font.Code
    animationButton.TextSize = 11
    animationButton.TextXAlignment = Enum.TextXAlignment.Left
    animationButton.Parent = scrollframe2

    corner(animationButton, 6)
    stroke(animationButton, Color3.fromRGB(50, 35, 70), 0.8)
    UIMotion.ApplyElasticPress(animationButton, UDim2.new(0.96, 0, 0, 36))

    local isPlaying = false
    local activeTracks = {}

    animationButton.MouseButton1Click:Connect(function()
        targetPlayer = getTarget()
        isTeleporting = not isTeleporting

        if isTeleporting and targetPlayer then
            animationButton.BackgroundColor3 = THEME.NeonPrimary
            animationButton.TextColor3 = THEME.Background
            showNotification("<font color='#34D399'>// SECUENCIA</font>", "<font color='#F5F3FF'>Iniciando: " .. nam .. "</font>", 2)
            
            task.spawn(function()
                while isTeleporting and targetPlayer and targetPlayer.Character do
                    local tRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local lRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot and lRoot then
                        lRoot.CFrame = tRoot.CFrame * currentOffset
                        if tick() - lastToggle >= tog then
                            currentOffset = (currentOffset == cof1) and cof2 or cof1
                            lastToggle = tick()
                        end
                    end
                    RunService.Stepped:Wait()
                end
            end)
        else
            isTeleporting = false
            animationButton.BackgroundColor3 = THEME.Element
            animationButton.TextColor3 = THEME.Subtext
            showNotification("<font color='#F87171'>// SECUENCIA</font>", "<font color='#F5F3FF'>Detenida: " .. nam .. "</font>", 2)
        end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            if isPlaying then
                for _, t in ipairs(activeTracks) do t:Stop() end
                activeTracks = {}
                isPlaying = false
            else
                for _, id in ipairs({Ida, Idb}) do
                    if id and id ~= "" then
                        local tr = loadAndPlayAnim(hum, id)
                        if tr then table.insert(activeTracks, tr) end
                    end
                end
                isPlaying = true
            end
        end
    end)
end

