-- Safe Graphic Animator Helper
local function loadAndPlayGraphicAnim(humanoid, assetId, speedVal)
    local success, track = pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. assetId
        local loaded = humanoid:LoadAnimation(anim)
        loaded.Looped = true
        loaded:Play()
        if speedVal and speedVal ~= 0 then
            loaded:AdjustSpeed(speedVal)
        end
        return loaded
    end)
    if success then
        return track
    end
    return nil
end

-- Graphic Animation System (Solo animaciones visuales/estéticas para el propio avatar)
local function registerGraphicAnimation(nam, Ida, Idb, Idc, Idd, speedVal)
    local isPlaying = false
    local activeTracks = {}

    local animationButton = Instance.new("TextButton")
    animationButton.Size = UDim2.new(0.95, 0, 0, 38)
    animationButton.BackgroundColor3 = THEME.Element
    animationButton.Text = "  ⚡ " .. nam
    animationButton.TextColor3 = THEME.Subtext
    animationButton.Font = Enum.Font.Code
    animationButton.TextSize = 12
    animationButton.TextXAlignment = Enum.TextXAlignment.Left
    animationButton.Parent = scrollframe2

    corner(animationButton, 8)
    stroke(animationButton, Color3.fromRGB(50, 35, 70), 1)
    UIMotion.ApplyElasticPress(animationButton, UDim2.new(0.95, 0, 0, 38))

    animationButton.MouseButton1Click:Connect(function()
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end

        if isPlaying then
            for _, track in ipairs(activeTracks) do
                track:Stop()
            end
            activeTracks = {}
            isPlaying = false
            animationButton.BackgroundColor3 = THEME.Element
            animationButton.TextColor3 = THEME.Subtext
            showNotification("<font color='#F87171'>// ANIMACIÓN</font>", "<font color='#F5F3FF'>Detenido: " .. nam .. "</font>", 2)
        else
            activeTracks = {}
            local ids = {Ida, Idb, Idc, Idd}
            for _, id in ipairs(ids) do
                if id and id ~= "0" and id ~= "" then
                    local track = loadAndPlayGraphicAnim(humanoid, id, speedVal or 1)
                    if track then
                        table.insert(activeTracks, track)
                    end
                end
            end
            isPlaying = true
            animationButton.BackgroundColor3 = THEME.NeonPrimary
            animationButton.TextColor3 = THEME.Background
            showNotification("<font color='#34D399'>// ANIMACIÓN</font>", "<font color='#F5F3FF'>Reproduciendo: " .. nam .. "</font>", 2)
        end
    end)
end

