-- Safe Animator Helper with Multi-Speed Control
local function loadAndPlayAnim(humanoid, assetId, speedVal)
    local success, track = pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. assetId
        local loaded = humanoid:LoadAnimation(anim)
        loaded.Looped = true
        loaded:Play()
        if speedVal and speedVal ~= 0 then
            loaded:AdjustSpeed(speedVal)
        end
        return loaded
    end)
    if success then
        return track
    end
    return nil
end

-- Teleport & Animation System 1 (Backshots & Close Proximity Loops)
local function se(nam, Ida, Idb, Idc, Idd, ssa, ssb, duration, sp, cof1, cof2, speed, tog)
    local isTeleporting = false
    local targetPlayer = nil
    local offset1 = cof1
    local offset2 = cof2
    local currentOffset = offset1
    local toggleInterval = tog
    local lastToggleTime = tick()

    local function getTargetPlayerByName(name)
        local lowerName = name:lower()
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name:lower():sub(1, #lowerName) == lowerName or p.DisplayName:lower():sub(1, #lowerName) == lowerName then
                return p
            end
        end
        return nil
    end

    local function startTeleport()
        if targetPlayer and targetPlayer.Character then
            local targetRootPart = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            local localRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

            if targetRootPart and localRootPart then
                local teleportLoop
                teleportLoop = RunService.Stepped:Connect(function(_, deltaTime)
                    if isTeleporting then
                        localRootPart.CFrame = localRootPart.CFrame:Lerp(targetRootPart.CFrame * currentOffset, deltaTime * speed)
                        if tick() - lastToggleTime >= toggleInterval then
                            currentOffset = (currentOffset == offset1) and offset2 or offset1
                            lastToggleTime = tick()
                        end
                    else
                        teleportLoop:Disconnect()
                    end
                end)
            end
        end
    end

    local isPlaying = false
    local activeTracks = {}

    local animationButton = Instance.new("TextButton")
    animationButton.Size = UDim2.new(0.95, 0, 0, 38)
    animationButton.BackgroundColor3 = THEME.Element
    animationButton.Text = "  ⚡ " .. nam
    animationButton.TextColor3 = THEME.Subtext
    animationButton.Font = Enum.Font.Code
    animationButton.TextSize = 12
    animationButton.TextXAlignment = Enum.TextXAlignment.Left
    animationButton.Parent = scrollframe2

    corner(animationButton, 8)
    stroke(animationButton, Color3.fromRGB(50, 35, 70), 1)

    animationButton.MouseButton1Click:Connect(function()
        targetPlayer = getTargetPlayerByName(namebox.Text)

        if isTeleporting then
            isTeleporting = false
            showNotification("<font color='#F87171'>// ACCIÓN</font>", "<font color='#F5F3FF'>Detenido: " .. nam .. "</font>", 2)
        else
            isTeleporting = true
            startTeleport()
            showNotification("<font color='#34D399'>// ACCIÓN</font>", "<font color='#F5F3FF'>Ejecutando: " .. nam .. "</font>", 2)
        end

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end

        if isPlaying then
            for _, track in ipairs(activeTracks) do
                track:Stop()
            end
            activeTracks = {}
            isPlaying = false
            animationButton.BackgroundColor3 = THEME.Element
            animationButton.TextColor3 = THEME.Subtext
        else
            activeTracks = {}
            local ids = {Ida, Idb, Idc, Idd, ssa, ssb}
            for _, id in ipairs(ids) do
                if id and id ~= "0" and id ~= "" then
                    local track = loadAndPlayAnim(humanoid, id, 1)
                    if track then
                        table.insert(activeTracks, track)
                    end
                end
            end
            isPlaying = true
            animationButton.BackgroundColor3 = THEME.NeonPrimary
            animationButton.TextColor3 = THEME.Background

            task.delay(duration, function()
                if isPlaying then
                    for _, track in ipairs(activeTracks) do
                        track:AdjustSpeed(sp)
                    end
                end
            end)
        end
    end)
end

